<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <AssemblyName>TuneForge</AssemblyName>
    <RootNamespace>TuneForge.Host</RootNamespace>
    <OutputPath>$(AppOutput)</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3719.77" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\TuneForge.Engine.Core\TuneForge.Engine.Core.csproj" />
    <ProjectReference Include="..\TuneForge.Engine\TuneForge.Engine.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="wwwroot\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
